; Engine configuration file.
; mxdpppplus — pixel-art card battle game
config_version=5

[application]

config/name="mxdpppplus"
config/description="Pixel-art multiplayer card battle game"
config/version="1.0.2"
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Net="*res://common/net.gd"
App="*res://client/app.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.05, 0.03, 0.11, 1)

[input_devices]

pointing/emulate_touch_from_mouse=false

[network]

limits/debugger_stdout/logging=false
